<Control
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:profile="clr-namespace:Content.Client.Lobby.UI.ProfileEditorControls"
    xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client">
    <PanelContainer>
        <PanelContainer.PanelOverride>
            <gfx:StyleBoxFlat BackgroundColor="#25252AE6" BorderColor="#3A3A44" BorderThickness="1" />
        </PanelContainer.PanelOverride>
        <BoxContainer Name="VBox" Orientation="Vertical" Margin="10 10 10 10" HorizontalExpand="True">
            <controls:NanoHeading Name="Header" Text="{Loc 'lobby-character-preview-panel-header'}" />
            <BoxContainer Name="Loaded" Orientation="Vertical"
                          Visible="False" Margin="0 6 0 0">
                <Label Name="Summary" HorizontalAlignment="Center" Margin="3 3"/>
                <BoxContainer Name="ViewBox" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 6 0 0">
                    <PanelContainer>
                        <PanelContainer.PanelOverride>
                            <gfx:StyleBoxFlat BackgroundColor="#1A1A1AE6" BorderColor="#3A3A44" BorderThickness="1" />
                        </PanelContainer.PanelOverride>
                        <profile:ProfilePreviewSpriteView Name="ProfilePreviewSpriteView"
                                                          OverrideDirection="South"
                                                          Scale="4 4"
                                                          MaxSize="112 112"
                                                          Stretch="Fill"
                                                          Access="Public" />
                    </PanelContainer>
                </BoxContainer>
                <controls:VSpacer/>
                <Button Name="CharacterSetup" Text="{Loc 'lobby-character-preview-panel-character-setup-button'}"
                        HorizontalAlignment="Center"
                        StyleClasses="ButtonBig"
                        Margin="0 8 0 0"/>
            </BoxContainer>
            <Label Name="Unloaded" Text="{Loc 'lobby-character-preview-panel-unloaded-preferences-label'}" Margin="0 6 0 0"/>
        </BoxContainer>
    </PanelContainer>
</Control>
