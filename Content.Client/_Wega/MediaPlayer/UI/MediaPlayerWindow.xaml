<controls:FancyWindow xmlns="https://spacestation14.io"
        xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
        xmlns:xe="clr-namespace:Content.Client.UserInterface.XamlExtensions"
        Title="{Loc 'ui-media-player-title'}"
        SetSize="820 560"
        MinSize="600 430">
    <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True" Margin="10">

        <!-- Search / direct URL -->
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <LineEdit Name="SearchField"
                      PlaceHolder="{Loc 'ui-media-player-search-placeholder'}"
                      HorizontalExpand="True" />
            <Button Name="SearchButton" Text="{Loc 'ui-media-player-search-button'}" Margin="4 0 0 0" />
            <Button Name="PlayUrlButton" Text="{Loc 'ui-media-player-play-url-button'}" Margin="4 0 0 0" />
        </BoxContainer>

        <Label Name="StatusLabel" Text="" Margin="2 6 0 6" />

        <!-- Results (panel wraps the list so the empty-state hint can sit centered on top).
             Expands to fill whatever the card/queue leave free, so there's no dead space. -->
        <PanelContainer Name="ResultsPanel" VerticalExpand="True" MinHeight="96" Margin="0 0 0 4">
            <ItemList Name="ResultsList" VerticalExpand="True" HorizontalExpand="True" SelectMode="Single" />
            <Label Name="EmptyHintLabel"
                   Text="{Loc 'ui-media-player-empty-hint'}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Align="Center" MouseFilter="Ignore" />
        </PanelContainer>

        <!-- Pagination + queue controls + enqueue, all on one compact row -->
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 0 0 6" VerticalAlignment="Center">
            <Button Name="PrevPageButton" Text="&lt;" Disabled="True" />
            <Label Name="PageLabel" Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8 0 8 0" />
            <Button Name="NextPageButton" Text="&gt;" Disabled="True" />
            <Label Name="QueueHeaderLabel" Text="{Loc 'ui-media-player-queue-empty'}" StyleClasses="LabelSubText"
                   VerticalAlignment="Center" Margin="16 0 0 0" />
            <Control HorizontalExpand="True" />
            <Button Name="EnqueueButton" Text="{Loc 'ui-media-player-enqueue-button'}" Disabled="True" Margin="0 0 4 0" />
            <Button Name="ClearQueueButton" Text="{Loc 'ui-media-player-queue-clear'}" Disabled="True" />
        </BoxContainer>

        <!-- Queue list — collapsed entirely while the queue is empty (see RefreshQueue). -->
        <ItemList Name="QueueList" MinHeight="54" MaxHeight="108" Margin="0 0 0 6" SelectMode="Single" Visible="False" />

        <!-- Now playing card -->
        <PanelContainer Name="NowPlayingPanel" StyleClasses="BackgroundPanel">
            <BoxContainer Orientation="Vertical" Margin="10 8 10 8">

                <BoxContainer Orientation="Horizontal" VerticalAlignment="Center">
                    <TextureRect Name="NoteIcon"
                                 Texture="{xe:Tex '/Textures/_Wega/Interface/MediaPlayer/note.png'}"
                                 Stretch="KeepAspectCentered"
                                 MinSize="40 40"
                                 Margin="0 0 8 0"
                                 VerticalAlignment="Center" />
                    <Label Name="NowPlayingLabel" Text="{Loc 'ui-media-player-nothing'}"
                           StyleClasses="LabelHeading" ClipText="True"
                           HorizontalExpand="True" VerticalAlignment="Center" />
                </BoxContainer>

                <!-- Progress: draggable slider so the playhead can be moved -->
                <Slider Name="ProgressSlider" MinValue="0" MaxValue="1" Value="0"
                        MinHeight="14" Margin="0 8 0 2" HorizontalExpand="True" />

                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                    <Label Name="TimeCurrentLabel" Text="0:00" StyleClasses="LabelSubText" />
                    <Control HorizontalExpand="True" />
                    <Label Name="TimeTotalLabel" Text="0:00" StyleClasses="LabelSubText" />
                </BoxContainer>

                <!-- Transport: play/pause + stop + repeat + shuffle -->
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 8 0 0" SeparationOverride="6">
                    <Button Name="PlayPauseButton" Text="{Loc 'ui-media-player-play-button'}"
                            HorizontalExpand="True" SizeFlagsStretchRatio="2" MinHeight="32" Disabled="True" />
                    <Button Name="StopButton" Text="{Loc 'ui-media-player-stop-button'}"
                            HorizontalExpand="True" SizeFlagsStretchRatio="2" MinHeight="32" Disabled="True" />
                    <Button Name="RepeatButton" Text="{Loc 'ui-media-player-repeat-button'}"
                            HorizontalExpand="True" SizeFlagsStretchRatio="1" MinHeight="32" ToggleMode="True" />
                    <Button Name="ShuffleButton" Text="{Loc 'ui-media-player-shuffle-button'}"
                            HorizontalExpand="True" SizeFlagsStretchRatio="1" MinHeight="32" ToggleMode="True" />
                </BoxContainer>

                <!-- Volume + mute -->
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 8 0 0" VerticalAlignment="Center">
                    <Button Name="MuteButton" Text="{Loc 'ui-media-player-mute-button'}" ToggleMode="True" VerticalAlignment="Center" />
                    <Slider Name="VolumeSlider" MinValue="0" MaxValue="1" HorizontalExpand="True"
                            Margin="10 0 10 0" VerticalAlignment="Center" />
                    <Label Name="VolumePercentLabel" Text="50%" StyleClasses="LabelSubText"
                           MinWidth="38" Align="Right" VerticalAlignment="Center" />
                </BoxContainer>

            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
