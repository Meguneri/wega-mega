<widgets:MediaPlayerIndicator xmlns="https://spacestation14.io"
        xmlns:widgets="clr-namespace:Content.Client._Wega.MediaPlayer.UI"
        xmlns:xe="clr-namespace:Content.Client.UserInterface.XamlExtensions"
        VerticalExpand="False"
        HorizontalExpand="False"
        MouseFilter="Stop"
        Visible="False">
    <PanelContainer Name="BackgroundPanel" HorizontalAlignment="Center" MouseFilter="Ignore">
        <BoxContainer Orientation="Horizontal" VerticalAlignment="Center">
            <TextureRect Name="Icon"
                         Texture="{xe:Tex '/Textures/_Wega/Interface/MediaPlayer/note.png'}"
                         Stretch="KeepAspectCentered"
                         MinSize="16 16"
                         MaxSize="16 16"
                         VerticalAlignment="Center" />
            <Label Name="TitleLabel"
                   Text=""
                   Margin="5 0 0 0"
                   VerticalAlignment="Center"
                   ClipText="True" />
        </BoxContainer>
    </PanelContainer>
</widgets:MediaPlayerIndicator>
