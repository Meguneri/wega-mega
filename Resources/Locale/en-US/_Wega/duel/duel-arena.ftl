# Comeback bonus after losing 3 duels in a row
duel-arena-loser-minion-spawned = { $name } gains the Right of Revenge after a losing streak!
duel-arena-revenge-activated = RIGHT OF REVENGE!

# arenacold command — controls cold on the current grid
cmd-arenacold-desc = Enables or disables Frostpunk arena cold on the current grid.
cmd-arenacold-help = Usage: { $command } <on|off>
cmd-arenacold-invalid-args = Invalid arguments. Usage: { $command } <on|off>
cmd-arenacold-player-only = This command can only be used by a player who is in-game.
cmd-arenacold-no-grid = You must be standing on an arena grid.
cmd-arenacold-on-result = Cold enabled on grid { $grid }. EVERYONE on this grid will freeze.
cmd-arenacold-off-result = Cold disabled on grid { $grid }. Snowfall stopped as well.
cmd-arenacold-on-already = Grid { $grid } already had cold enabled - nothing changed.
cmd-arenacold-off-already = Grid { $grid } had no cold zone - nothing changed.
